{
  "llm": {
    "base_url": "https://ark.cn-beijing.volces.com/api/v3",
    "api_key_env": "ARK_API_KEY",
    "ark_request_timeout_seconds": 90,
    "models": {
      "writer": "gpt-5.5",
      "outline": "gpt-5.5",
      "final_editor": "gpt-5.5",
      "reviewer": "glm-5-2-260617",
      "state_delta": "gpt-5.5",
      "cn_summary": "deepseek-v4-flash-ga-260731",
      "radar": "deepseek-v4-flash-ga-260731",
      "handoff": "deepseek-v4-flash-ga-260731"
    },
    "relay": {
      "wire_api": "responses",
      "role_wire_apis": {
        "writer": "chat_completions",
        "outline": "chat_completions",
      "final_editor": "chat_completions",
      "state_delta": "chat_completions"
      },
      "stream_roles": ["writer", "outline", "state_delta"],
      "stream_total_timeout_seconds": 300,
      "writer_fallback": {
        "model": "gpt-5.6-terra",
        "primary_max_attempts": 3,
        "primary_request_timeout_seconds": 150
      },
      "planning_fallback": {
        "model": "gpt-5.6-terra",
        "request_max_attempts": 1,
        "request_timeout_seconds": 75
      },
      "headers": {
        "x-openai-actor-authorization": "local-image-extension"
      }
    },
      "note": "2026-10-20 实测：中继目录列出 7 个 gpt 模型，仅 gpt-5.5 与 gpt-5.6-terra 路由可达；gpt-5.6-sol / gpt-6.1-sol / gpt-6-astra / gpt-6-sol 均返回 502 upstream_error（目录里有、上游通道被拒），故 writer/outline 及两者 fallback 只能在这两个可达模型间分配。旧注释曾称 gpt-6.1-sol 是已验证的 writer fallback，但历史 writer 记录为 9 成功 / 24 失败，该说法不成立。正文、末尾 AI 检测、修复和 state_delta 使用 gpt-5.5 流式中继；reviewer、摘要和雷达保留 Ark。"
  },
  "writing": {
    "default_chapters": 12,
    "default_words": 2500,
    "word_band": 0.1,
    "max_rewrite": 2,
    "temperature": 0.85,
    "serial_mode": true,
    "parallel_blocks": 2,
    "segment_words": 500,
    "segment_max_tokens": 1200,
    "segment_request_timeout_seconds": 75,
    "segment_request_attempts": 1,
    "segment_cooldown": 1,
    "segment_recovery_attempts": 1,
    "segment_recovery_wait_seconds": 20,
    "recovery_rounds": 3,
    "recovery_wait_seconds": 90,
    "experience_runtime": {
      "enabled": true,
      "pack": "distill/sandbox_experience_pack.json",
      "max_items": 2
    }
  },
  "genre_keywords": {
    "lgbt_romance": ["lgbtq+", "lgbt", "queer romance", "bisexual romance", "same-sex romance"],
    "dark_romance": ["dark romance", "dark adult romance"],
    "domestic_suspense": ["suspense", "thriller", "crime", "mystery", "noir", "forensic", "murder"],
    "webfiction": ["fantasy", "litrpg", "progression", "isekai", "romantasy", "cultivation", "time loop", "system", "dungeon"],
    "literary": ["literary", "contemporary", "family drama", "coming of age"]
  },
  "paths": {
    "anchor_examples": "anchor_examples",
    "output": "shorts",
    "probe": "probe"
  }
}
