{
  "limits": {
    "max_stories_per_day": 2,
    "daily_token_budget": 2000000,
    "approx_tokens_per_story": 500000
  },
  "switches": {
    "new_short_enabled": true,
    "serial_enabled": false,
    "auto_replace_enabled": false
  },
  "quality": {
    "quality_min": 4,
    "native_min": 4,
    "engagement_min": 3
  },
  "chapter_acceptance": {
    "enabled": true,
    "max_repair_rounds": 2
  },
  "final_editor": {
    "enabled": true,
    "timeout_seconds": 7200,
    "unresolved_remediation_rounds": 2,
    "dossier_role": "final_editor",
    "plan_role": "final_editor",
    "editor_role": "final_editor",
    "review_role": "final_editor"
  },
  "radar": {
    "sources": "inkitt_browser,inkitt_browser_validation,amazon",
    "list": 20,
    "no_chapters": true,
    "recommend_count": 4,
    "portfolio": "weighted",
    "category_mode": "separate_validation"
  },
  "notify": {
    "enabled": false,
    "channel": "desktop"
  },
  "schedule_note": "用 Windows 计划任务分别触发：radar 每6小时，produce-cycle 每30分钟"
}
