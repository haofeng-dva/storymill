# Copy this file to .env and fill in only credentials for configured routes.
# Never commit .env or keys.local.json.

# Ark-compatible provider credentials (see config.json: llm.api_key_env).
# ARK_API_KEY=

# Optional OpenAI-compatible relay credentials.
# OPENAI_RELAY_BASE=
# OPENAI_RELAY_KEY=

# Optional Gemini credentials/proxy.
# GEMINI_API_KEY=
# GEMINI_PROXY=

# Optional radar/browser integration.
# INKITT_COOKIE=
